{{/*
  column — section-usage template layout.

  Context: map[string]any keyed by the section's fields. `people` is a slice
  of `person` section instance maps (composition: column -> people -> person).
  Each is rendered inline here rather than through a cross-template
  `{{ template "person" . }}` call, so the layout executes standalone against
  its own render context (checkLibraryExamples executes each template's
  layout in isolation).
*/}}
<div class="demo-column">
  {{ with .title }}<h3 class="demo-column__title">{{ . }}</h3>{{ end }}
  {{ with .body }}<div class="demo-column__body">{{ . }}</div>{{ end }}
  {{ range .people }}
  <div class="demo-person">
    {{ with .avatar }}<img class="demo-person__avatar" src="{{ . }}" alt="">{{ end }}
    <span class="demo-person__name">{{ .name }}</span>
    {{ with .role }}<span class="demo-person__role">{{ . }}</span>{{ end }}
  </div>
  {{ end }}
</div>
