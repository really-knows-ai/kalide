{{/*
  content — slide-usage template layout.

  Context: map[string]any keyed by field name; `columns` maps to a slice of
  TRUSTED HTML, one element per section instance in source order — each
  instance already rendered bottom-up through its own layout.html.tmpl
  (template-language). The layout splices each rendered instance with
  `{{ range .columns }}{{ . }}{{ end }}` rather than ranging over data maps and
  rendering the column layout inline.
*/}}
<section class="demo-slide demo-slide--content">
  <h2 class="demo-heading">{{ .heading }}</h2>
  {{ with .body }}<div class="demo-body">{{ . }}</div>{{ end }}
  <div class="demo-columns">
    {{ range .columns }}{{ . }}{{ end }}
  </div>
</section>
