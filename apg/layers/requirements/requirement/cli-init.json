{
  "layer": "requirements",
  "type": "requirement",
  "name": "cli-init",
  "body": "`eypres init` in the current directory creates `slides/` with two valid starter slides, an empty `assets/` directory for images, and a valid `eypres.yaml`. AC: immediately after init, `eypres start` validates cleanly and serves the two starter slides.",
  "properties": {
    "feature": "cli"
  },
  "out": [
    {
      "kind": "contains",
      "target": "requirements.requirement.cli-init-refuse-existing",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.service.scaffold-deck",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "target": "requirements.requirement.embedded-assets",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "requirements.user.deck-author",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "source": "requirements.requirement.native-ci-verification",
      "properties": {}
    }
  ]
}