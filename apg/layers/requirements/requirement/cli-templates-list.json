{
  "layer": "requirements",
  "type": "requirement",
  "name": "cli-templates-list",
  "body": "`kalide templates` lists every template in the resolved library (the configured `templates:` path, else the local `templates/`; see external-template-library) with its name, kind (slide|section — derived from whether it lives under the library's `slides/` or `sections/`) and one-line description. Run outside a project (no resolvable library) it errors per templates-dir-required.",
  "properties": {
    "feature": "cli"
  },
  "out": [
    {
      "kind": "contains",
      "target": "requirements.requirement.cli-templates-show",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.templates-gallery",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.service.template-registry",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "requirements.user.deck-author",
      "properties": {}
    },
    {
      "kind": "details",
      "source": "requirements.note.reconcile-kind-directories",
      "properties": {}
    },
    {
      "kind": "details",
      "source": "requirements.note.kalide-rename",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "source": "requirements.requirement.agent-authoring",
      "properties": {}
    }
  ]
}