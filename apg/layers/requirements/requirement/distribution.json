      "target": "requirements.requirement.native-ci-verification",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.homebrew-install",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.scoop-install",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.tap-bucket-location",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.package-manifest-update",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.install-docs",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.group.distribution",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.version-command",
      "properties": {}
