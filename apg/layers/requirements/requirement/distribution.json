{
  "layer": "requirements",
  "type": "requirement",
  "name": "distribution",
  "body": "kalide is built, verified, released and installed through a defined distribution pipeline: public GitHub source repo (really-knows-ai/kalide), native-CI verification, public GitHub Releases assets (`kalide-<os>-<arch>`), Homebrew (macOS, both architectures) / Scoop (Windows) as the primary install channels, and a direct anonymous GitHub Release download for Linux (no package-manager channel) and as a fallback elsewhere. No step requires a GitHub account or token (global.constraint.anonymous-install).",
  "properties": {
    "feature": "distribution"
  },
  "out": [
    {
