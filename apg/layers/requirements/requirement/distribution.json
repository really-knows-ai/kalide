{
  "layer": "requirements",
  "type": "requirement",
  "name": "distribution",
  "body": "kalide is built, verified, released and installed through a defined distribution pipeline for the six supported targets (supported-platforms): public GitHub source repo (really-knows-ai/kalide), native-CI verification, public GitHub Releases assets (`kalide-<os>-<arch>`) for darwin/arm64, darwin/amd64, windows/amd64, windows/arm64, linux/amd64 and linux/arm64, Homebrew (both macOS architectures) / Scoop (Windows, amd64 and arm64) as the primary install channels, and a direct anonymous GitHub Release download for Linux (both architectures) and as a fallback elsewhere. Every step is anonymous (global.constraint.anonymous-install).",
  "properties": {
    "feature": "distribution"
  },
  "out": [
    {
      "kind": "contains",
      "target": "requirements.requirement.source-repo",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.supported-platforms",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.github-releases",
      "properties": {}
    },
    {
