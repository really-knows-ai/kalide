{
  "layer": "requirements",
  "type": "requirement",
  "name": "error-reporting",
  "body": "Validation is fail-fast: exactly one error is reported (the first found). It states file, line if known, full path, what is wrong and how to fix it, e.g. `slides/3-team.md:12 › column[1] › people[0] › name: required — add a name: value`. Same text in terminal and browser error page.",
  "properties": {
    "feature": "validation-errors"
  },
  "out": [
    {
      "kind": "drives",
      "target": "domain.value.validation-error",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "requirements.requirement.whole-deck-validation",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "source": "requirements.requirement.live-reload-error-page",
      "properties": {}
    },
    {
      "kind": "details",
      "source": "requirements.note.reconcile-failfast-theme-navigation",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "source": "requirements.requirement.templates-dir-validation",
      "properties": {}
    }
  ]
}