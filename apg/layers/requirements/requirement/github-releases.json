{
  "layer": "requirements",
  "type": "requirement",
  "name": "github-releases",
  "body": "On a version tag, a GitHub Actions release workflow builds one binary per supported target (see supported-platforms) and publishes them, with checksums, as assets of a GitHub Release on the public repo, downloadable anonymously. AC: a pushed tag `vX.Y.Z` yields a Release `vX.Y.Z` with a checksums file and one binary for each of the six targets (darwin/arm64, darwin/amd64, windows/amd64, windows/arm64, linux/amd64, linux/arm64) for which a native runner existed at release time — no more, no less; each asset downloads via its release URL without authentication.",
  "properties": {
    "feature": "distribution"
  },
  "out": [
    {
      "kind": "drives",
      "target": "domain.entity.release",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.service.publish-release",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "target": "requirements.requirement.native-ci-verification",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "target": "requirements.requirement.supported-platforms",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "requirements.requirement.distribution",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "source": "requirements.requirement.homebrew-install",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "source": "requirements.requirement.scoop-install",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "source": "requirements.requirement.package-manifest-update",
      "properties": {}
    },
    {
      "kind": "details",
      "source": "requirements.note.fix-supported-targets-runners",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "source": "requirements.requirement.version-command",
      "properties": {}
    },
    {
      "kind": "details",
      "source": "requirements.note.reconcile-public-install",
      "properties": {}
    }
  ]
}