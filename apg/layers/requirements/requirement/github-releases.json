{
  "layer": "requirements",
  "type": "requirement",
  "name": "github-releases",
  "body": "On a version tag, a GitHub Actions release workflow builds one binary per supported target (see supported-platforms) and publishes them, with checksums, as assets of a GitHub Release on the private repo. AC: a pushed tag `vX.Y.Z` yields a Release `vX.Y.Z` with a checksums file and one binary for each supported target: darwin/arm64 and windows/amd64 always, windows/arm64 only if its native runner was available, and never darwin/amd64 or Linux.",
  "properties": {
    "feature": "distribution"
  },
  "out": [
    {
      "kind": "drives",
      "target": "domain.entity.release",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.service.publish-release",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "target": "requirements.requirement.native-ci-verification",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "target": "requirements.requirement.supported-platforms",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "requirements.requirement.distribution",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "source": "requirements.requirement.homebrew-install",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "source": "requirements.requirement.scoop-install",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "source": "requirements.requirement.package-manifest-update",
      "properties": {}
    },
    {
      "kind": "details",
      "source": "requirements.note.fix-supported-targets-runners",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "source": "requirements.requirement.version-command",
      "properties": {}
    }
  ]
}