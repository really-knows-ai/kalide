{
  "layer": "requirements",
  "type": "requirement",
  "name": "live-reload",
  "body": "While `eypres start` runs, changes to `slides/`, `assets/`, `templates/` or `eypres.yaml` are detected, the templates dir and deck are re-validated and re-rendered, and the open browser reloads automatically (see templates-live-reload).",
  "properties": {
    "feature": "presenting"
  },
  "out": [
    {
      "kind": "contains",
      "target": "requirements.requirement.live-reload-error-page",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.service.watch-deck",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.entity.deck-changed",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "target": "requirements.requirement.whole-deck-validation",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "requirements.requirement.cli-start",
      "properties": {}
    },
    {
      "kind": "details",
      "source": "requirements.note.fix-cli-start-port",
      "properties": {}
    }
  ]
}