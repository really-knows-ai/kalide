{
  "layer": "requirements",
  "type": "requirement",
  "name": "live-reload",
  "body": "While `kalide start` runs, changes to `slides/`, `assets/` or `kalide.yaml`, or anywhere under the resolved library root (the configured `templates:` path when set, otherwise the local `templates/`; see external-template-library), are detected; the resolved library and the deck are re-validated and re-rendered, and the open browser reloads automatically (see templates-live-reload).",
  "properties": {
    "feature": "presenting"
  },
  "out": [
    {
      "kind": "contains",
      "target": "requirements.requirement.live-reload-error-page",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.service.watch-deck",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.entity.deck-changed",
      "properties": {}
    },
    {
      "kind": "depends-on",
      "target": "requirements.requirement.whole-deck-validation",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "requirements.requirement.cli-start",
      "properties": {}
    },
    {
      "kind": "details",
      "source": "requirements.note.fix-cli-start-port",
      "properties": {}
    },
    {
      "kind": "details",
      "source": "requirements.note.kalide-rename",
      "properties": {}
    }
  ]
}