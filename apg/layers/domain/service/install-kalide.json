{
  "layer": "domain",
  "type": "service",
  "name": "install-kalide",
  "body": "Install kalide: a user adds the tap `really-knows-ai/kalide` (macOS) or the bucket `kalide` (Windows), supplies a GitHub token, and the package manager fetches the matching `kalide-<os>-<arch>` binary from the private release and installs it.",
  "properties": {},
  "out": [
    {
      "kind": "realised-by",
      "target": "solution.component.install-docs",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.homebrew-formula",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.scoop-manifest",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "drives",
      "source": "requirements.requirement.scoop-install",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.homebrew-install",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.install-docs",
      "properties": {}
    },
    {
      "kind": "contains",
      "source": "domain.group.distribution",
      "properties": {}
    },
    {
      "kind": "details",
      "source": "requirements.note.kalide-rename",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.readme-presentation",
      "properties": {}
    }
  ]
}