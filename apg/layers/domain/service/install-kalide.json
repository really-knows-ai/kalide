{
  "layer": "domain",
  "type": "service",
  "name": "install-kalide",
  "body": "Install kalide: a user adds the tap `really-knows-ai/kalide` (macOS) or the bucket `kalide` (Windows) — the primary channels — and the package manager anonymously fetches the matching `kalide-<os>-<arch>` binary from the public release and installs it; no GitHub account or token is needed. For Linux (no package-manager channel), and as a fallback elsewhere, the user downloads the matching release asset directly, marks it executable, and runs it.",
  "properties": {},
  "out": [
    {
      "kind": "realised-by",
      "target": "solution.component.install-docs",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.homebrew-formula",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.scoop-manifest",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.linux-release-asset",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.anonymous-install-e2e",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "drives",
      "source": "requirements.requirement.scoop-install",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.homebrew-install",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.install-docs",
      "properties": {}
    },
    {
      "kind": "contains",
      "source": "domain.group.distribution",
      "properties": {}
    },
    {
      "kind": "details",
      "source": "requirements.note.kalide-rename",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.readme-presentation",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.linux-install",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.readme-install-front-loading",
      "properties": {}
    },
    {
      "kind": "details",
      "source": "requirements.note.reconcile-public-install",
      "properties": {}
    }
  ]
}