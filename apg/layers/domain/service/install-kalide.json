{
  "layer": "domain",
  "type": "service",
  "name": "install-kalide",
  "body": "Install kalide: a user adds the tap `really-knows-ai/kalide` (macOS) or the bucket `kalide` (Windows) — the primary channels — and the package manager anonymously fetches the matching `kalide-<os>-<arch>` binary from the public release and installs it (global.constraint.anonymous-install). Linux, which has no package-manager channel, and the fallback route elsewhere, use a direct anonymous download of the matching release asset, which the user marks executable and runs.",
  "properties": {},
  "out": [
    {
      "kind": "realised-by",
      "target": "solution.component.install-docs",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.homebrew-formula",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.scoop-manifest",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.linux-release-asset",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.anonymous-install-e2e",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "drives",
      "source": "requirements.requirement.scoop-install",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.homebrew-install",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.install-docs",
      "properties": {}
    },
    {
      "kind": "contains",
      "source": "domain.group.distribution",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.readme-presentation",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.linux-install",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.readme-install-front-loading",
      "properties": {}
    }
  ]
}