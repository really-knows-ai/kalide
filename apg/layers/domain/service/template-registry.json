{
  "layer": "domain",
  "type": "service",
  "name": "template-registry",
  "body": "Template registry: hold the project's loaded templates (kind by directory: slides/ or sections/), run the load-time checks (cycles, directory-kind checks, cross-kind name uniqueness, reserved names, references, examples), own the central layout function set (v1: `media`), look up templates, describe them for CLI/gallery.",
  "properties": {},
  "out": [
    {
      "kind": "realised-by",
      "target": "solution.component.template-registry",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.cli-commands",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "domain.group.templating",
      "properties": {}
    },
    {
      "kind": "calls",
      "source": "domain.service.validate-deck",
      "properties": {}
    },
    {
      "kind": "calls",
      "source": "domain.service.render-deck",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.cli-templates-list",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.cli-templates-show",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.template-build-checks",
      "properties": {}
    }
  ]
}