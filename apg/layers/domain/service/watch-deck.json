{
  "layer": "domain",
  "type": "service",
  "name": "watch-deck",
  "body": "Watch deck: watch deck files, debounce, publish deck-changed; on change reload→validate→render and publish deck-rebuilt.",
  "properties": {},
  "out": [
    {
      "kind": "publishes",
      "target": "domain.entity.deck-changed",
      "properties": {}
    },
    {
      "kind": "publishes",
      "target": "domain.entity.deck-rebuilt",
      "properties": {}
    },
    {
      "kind": "calls",
      "target": "domain.service.validate-deck",
      "properties": {}
    },
    {
      "kind": "calls",
      "target": "domain.service.render-deck",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "domain.group.presentation",
      "properties": {}
    }
  ]
}