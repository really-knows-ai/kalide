{
  "layer": "domain",
  "type": "service",
  "name": "watch-deck",
  "body": "Watch deck: watch deck files (slides/, assets/, kalide.yaml) and everything under the project's templates/ dir (library.yaml, slides/, sections/, themes/, media/), debounce, publish deck-changed; on change reload templates→validate→render and publish deck-rebuilt.",
  "properties": {},
  "out": [
    {
      "kind": "publishes",
      "target": "domain.entity.deck-changed",
      "properties": {}
    },
    {
      "kind": "publishes",
      "target": "domain.entity.deck-rebuilt",
      "properties": {}
    },
    {
      "kind": "calls",
      "target": "domain.service.validate-deck",
      "properties": {}
    },
    {
      "kind": "calls",
      "target": "domain.service.render-deck",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.file-watcher",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "domain.group.presentation",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.live-reload",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.templates-live-reload",
      "properties": {}
    },
    {
      "kind": "details",
      "source": "requirements.note.kalide-rename",
      "properties": {}
    }
  ]
}