{
  "layer": "domain",
  "type": "service",
  "name": "serve-deck",
  "body": "Serve deck: HTTP serving of the rendered deck (or error page), embedded assets, deck assets/, /templates gallery, live-reload channel.",
  "properties": {},
  "out": [
    {
      "kind": "subscribes",
      "target": "domain.entity.deck-rebuilt",
      "properties": {}
    },
    {
      "kind": "calls",
      "target": "domain.service.render-deck",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.http-server",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "domain.group.presentation",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.cli-start",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.templates-gallery",
      "properties": {}
    }
  ]
}