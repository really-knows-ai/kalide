{
  "layer": "domain",
  "type": "service",
  "name": "validate-deck",
  "body": "Validate deck: apply config, filename, template, section, field, body/Markdown, link and image rules uniformly at every level; return all validation errors.",
  "properties": {},
  "out": [
    {
      "kind": "calls",
      "target": "domain.service.load-deck",
      "properties": {}
    },
    {
      "kind": "calls",
      "target": "domain.service.template-registry",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "domain.group.validation",
      "properties": {}
    },
    {
      "kind": "calls",
      "source": "domain.service.watch-deck",
      "properties": {}
    }
  ]
}