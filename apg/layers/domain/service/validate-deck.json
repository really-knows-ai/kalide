{
  "layer": "domain",
  "type": "service",
  "name": "validate-deck",
  "body": "Validate deck: apply config, filename, template, section, field, body/Markdown, link and image rules uniformly at every level; fail-fast — stop at and return the first validation error.",
  "properties": {},
  "out": [
    {
      "kind": "calls",
      "target": "domain.service.load-deck",
      "properties": {}
    },
    {
      "kind": "calls",
      "target": "domain.service.template-registry",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.deck-validator",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.markdown-validator",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "domain.group.validation",
      "properties": {}
    },
    {
      "kind": "calls",
      "source": "domain.service.watch-deck",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.whole-deck-validation",
      "properties": {}
    }
  ]
}