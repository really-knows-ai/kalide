{
  "layer": "domain",
  "type": "service",
  "name": "render-deck",
  "body": "Render deck: turn a valid deck into reveal.js HTML via template layouts and theme, with vertical stacks, anchors, notes, navigation config. Each slide renders deterministically to its `<section>` fragment, and the whole deck renders to the complete page the server serves; the same render is exposed per slide both as that fragment and as a standalone page, so `kalide render` writes each slide's final HTML to stdout or to a file (cli-render).",
  "properties": {},
  "out": [
    {
      "kind": "calls",
      "target": "domain.service.template-registry",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.deck-page",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.deck-renderer",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.cli-render",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "calls",
      "source": "domain.service.serve-deck",
      "properties": {}
    },
    {
      "kind": "calls",
      "source": "domain.service.watch-deck",
      "properties": {}
    },
    {
      "kind": "contains",
      "source": "domain.group.presentation",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.navigation-mode",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.pdf-via-print",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.slide-metadata",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.cli-render",
      "properties": {}
    }
  ]
}