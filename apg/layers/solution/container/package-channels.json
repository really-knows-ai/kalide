{
  "layer": "solution",
  "type": "container",
  "name": "package-channels",
  "body": "Package channels: the Homebrew tap `really-knows-ai/kalide` (`Formula/kalide.rb`) and Scoop bucket `kalide` (`bucket/kalide.json`, `bucket/README.md`), both hosted in the public source repo really-knows-ai/kalide, which users add anonymously to install kalide — the primary install channels on macOS and Windows.",
  "properties": {
    "kind": "service"
  },
  "out": [
    {
      "kind": "contains",
      "target": "solution.component.homebrew-formula",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "solution.component.scoop-manifest",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "solution.component.install-docs",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "solution.component.brand-assets",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "solution.component.linux-release-asset",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "realised-by",
      "source": "domain.group.distribution",
      "properties": {}
    },
    {
      "kind": "details",
      "source": "solution.note.distribution-solution",
      "properties": {}
    },
    {
      "kind": "contains",
      "source": "solution.system.kalide",
      "properties": {}
    }
  ]
}