{{/*
  content — slide-usage template layout.

  Context: map[string]any keyed by field name (see ../README.md); each declared
  section name maps to a slice of instance maps, rendered through the instance's
  section template.

  The `layout` enum selects the variant. `columns` composes any number of
  `column` section instances (the slide schema bounds the count to 2–4).
  Effects (the metric fragment) live here, not in author content.
*/}}
<section class="ey-slide ey-slide--content{{ with .layout }}{{ if eq . "columns" }} ey-slide--columns{{ end }}{{ end }}">
  <h2 class="ey-heading">{{ .heading }}</h2>
  {{ if .show_metric }}<p class="ey-metric fragment">{{ .metric }}</p>{{ end }}
  {{ with .as_of }}<p class="ey-date">{{ . }}</p>{{ end }}
  {{ with .body }}<div class="ey-body">{{ . }}</div>{{ end }}
  {{ with .layout }}{{ if eq . "columns" }}
  <div class="ey-columns">
    {{ range $.columns }}{{ template "column" . }}{{ end }}
  </div>
  {{ end }}{{ end }}
</section>
