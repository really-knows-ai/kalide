{{/*
  title — slide-usage template layout.

  Context: map[string]any keyed by field name (see ../README.md). The title
  slide takes data only: its implied body is disallowed.

  Controlled effects live here, never in author content: the slide fades in
  and paints the dark brand surface (theme tokens only).
*/}}
<section class="ey-slide ey-slide--title" data-transition="fade" data-background-color="var(--ey-bg-dark)">
  <h1 class="ey-title">{{ .title }}</h1>
  {{ with .subtitle }}<p class="ey-subtitle">{{ . }}</p>{{ end }}
  {{ with .date }}<p class="ey-date">{{ . }}</p>{{ end }}
</section>
